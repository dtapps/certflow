<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="certflow"
        Arguments=""
        InstallLocation="C:\Program Files\DTApp\CertFlow">
    </Installer>
    <PackageInformation
        PackageName="CertFlow"
        PackageDisplayName="CertFlow"
        PublisherName="CN=DTApp"
        PublisherDisplayName="DTApp"
        Version="0.1.0.0"
        PackageDescription="A certflow application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="net.dtapp.certflow"
                Description="A certflow application"
                DisplayName="CertFlow"
                ExecutableName="certflow"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>CertFlow</DisplayName>
            <PublisherDisplayName>DTApp</PublisherDisplayName>
            <Description>A certflow application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="certflow.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
