{
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^15.0.0",
    "@wailsio/runtime": "3.1.0",
    "echarts": "^6.1.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.5",
    "vue": "3.6.0-rc.14",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "typescript-eslint": "^8.72.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "license": "MIT",
  "name": "frontend",
  "packageManager": "pnpm@12.18.0",
  "private": true,
  "scripts": {
    "build": "vue-tsc && vite build --mode production",
    "build:dev": "vue-tsc && vite build --minify false --mode development",
    "deps:clean": "knip --fix",
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,css}\"",
    "lint": "eslint \"src/**/*.{vue,ts,js}\"",
    "lint:fix": "eslint --fix \"src/**/*.{vue,ts,js}\"",
    "lint:unused": "knip",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "version": "0.0.0"
}
